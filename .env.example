# ==================== Database Configuration ====================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=job_scraper_db
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# ==================== Airflow Configuration ====================
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/job_scraper_db
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_UID=50000

# ==================== AWS / S3 Mock (Floci) ====================
AWS_ENDPOINT_URL=http://floci:4566
LOCALSTACK_HOST=floci
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ==================== DuckDB Configuration ====================
DUCKDB_PATH=/opt/airflow/data/jobitvn.duckdb

# ==================== Portal Authentication (Optional) ====================
# LinkedIn credentials (used for initial cookie generation)
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# ITViec credentials (optional)
ITVIEC_EMAIL=
ITVIEC_PASSWORD=

# ==================== Proxy Configuration (Optional) ====================
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
